# Режим отладки: True для разработки, False для продакшена
DEBUG=True

# Секретный ключ Django
SECRET_KEY=your-secret-key-here

# Список хостов, с которых разрешён доступ к приложению (через запятую)
ALLOWED_HOSTS=localhost,127.0.0.1

# Настройки базы данных PostgreSQL
POSTGRES_DB=mailing_db
POSTGRES_USER=mailing_user
POSTGRES_PASSWORD=mailing_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL для подключения к Redis (кэширование и фоновые задачи, если будут)
REDIS_URL=redis://127.0.0.1:6379/1

# Настройки email-отправки (для рассылок)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
